{
  "name": "@diegoalvarezf/claude-usage-tracker",
  "version": "2.0.0",
  "description": "Monitor de uso y costes de Claude Code (y Codex CLI / Gemini CLI) para Windows — bandeja del sistema + reporte HTML",
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "usage",
    "tracker",
    "windows",
    "cost",
    "openai",
    "gemini",
    "codex"
  ],
  "author": "diegoalvarezf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoalvarezf/claude-usage-tracker-windows.git"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "bin": {
    "claude-usage": "claude-usage.js",
    "claude-usage-tray": "tray-launcher.js"
  },
  "scripts": {
    "postinstall": "node postinstall.js",
    "test": "node test/pricing.test.js && node test/providers.test.js",
    "sync-extension": "node -e \"require('fs').cpSync('lib','vscode-extension/lib',{recursive:true})\""
  },
  "files": [
    "claude-usage.js",
    "lib/",
    "tray.ps1",
    "tray-launcher.js",
    "postinstall.js",
    "orange-logo.svg",
    "README.md"
  ]
}
